# ─── Application ───────────────────────────────────────────────
APP_NAME=IOTRONCS Retail
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ─── PostgreSQL (pgAdmin / local) ────────────────────────────────
# Use these credentials in pgAdmin to connect and inspect the schema.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=businessos_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=businessos_core_erp
POSTGRES_SCHEMA=public

# Optional: full DSN overrides individual fields when set
# DATABASE_URL=postgresql+asyncpg://businessos_admin:change_me_strong_password@localhost:5432/businessos_core_erp

# ─── Security / JWT ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_long_random_secret_key_min_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (frontend dev server) ──────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

# ─── Multi-tenant ────────────────────────────────────────────────
DEFAULT_TENANT_PLAN=starter
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ─── Database bootstrap ─────────────────────────────────────────
AUTO_CREATE_TABLES=true
SEED_DEFAULT_PERMISSIONS=true

# ─── Email / SMTP (optional) ─────────────────────────────────────
# Example values for Gmail SMTP (use an app password when 2FA is enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=venaticfungus@gmail.com
MAIL_PASSWORD=zvnbqlfpxzfhlhca
MAIL_FROM=venaticfungus@gmail.com

# ─── Google OAuth (optional) ─────────────────────────────────────
# Register an OAuth client in Google Cloud Console and set these values.
# Redirect URI should match exactly one of the authorized redirect URIs, e.g.:
# http://localhost:8000/api/v1/auth/oauth/google/callback
# Then enable Google OAuth on the frontend by setting the backend env values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# ─── AI / LLM ────────────────────────────────────────────────────
# At least one key required for AI features (campaign copy, scoring, summarization)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=gemini

# ─── Meta / Facebook App OAuth ───────────────────────────────────
# Required to enable "Connect FB Page" OAuth flow in Ad Generator.
# 1. Go to https://developers.facebook.com → Create App → Business type
# 2. Add product: "Facebook Login for Business" (NOT Instagram)
# 3. In App Settings → Basic: copy App ID and App Secret below
# 4. In Facebook Login → Settings: add Valid OAuth Redirect URI:
#    http://localhost:8000/api/v1/crm/facebook/oauth-callback
# 5. Required permissions to request:
#    - pages_show_list, pages_read_engagement, pages_manage_posts, pages_manage_ads
#    - ads_management, ads_read (required to create paid ad campaigns)
#    - business_management (required for ad account access via system user tokens)
# 6. For production: your app must pass App Review for pages_manage_posts and
#    ads_management permissions
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/crm/facebook/oauth-callback
