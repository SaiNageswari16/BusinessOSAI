# RestaurantOS — Environment Configuration
# Copy to .env and fill in. Never commit .env.

# ─── Application ───
APP_NAME=RestaurantOS
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
APP_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# ─── Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ───
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── PostgreSQL (this is what pgAdmin connects to as well) ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=0111
POSTGRES_DB=restaurantos
POSTGRES_SCHEMA=public
# Set DATABASE_URL to override the discrete fields above entirely
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
AUTO_CREATE_TABLES=true

# ─── Redis (optional — auto-disables after REDIS_FAILURE_DISABLE_SECONDS of failure) ───
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_FAILURE_DISABLE_SECONDS=60
CACHE_TTL_SECONDS=300

# ─── MinIO / S3 storage (optional) ───
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=<SECRET_4809d954>T=restaurant-media
MINIO_SECURE=false

# ─── WhatsApp Gateway (Python FastAPI, see whatsapp_gateway/) ───
# Use 127.0.0.1 not localhost — Windows resolves localhost to IPv6 first.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:8005
WHATSAPP_ENABLED=false

# ─── Thermal Print Bridge (Python FastAPI, see print_bridge/) ───
PRINT_BRIDGE_URL=http://127.0.0.1:8006
PRINT_BRIDGE_ENABLED=false
KOT_PRINT_RETRY_MAX=5
KOT_PRINT_RETRY_DELAY_SECONDS=30

# ─── KDS / Realtime ───
KDS_WS_ENABLED=true
KDS_WS_HEARTBEAT_SECONDS=20
KOT_AUTO_ACK_TIMEOUT_MINUTES=5
KDS_POLL_FALLBACK_SECONDS=5
KITCHEN_BACKLOG_ALERT_COUNT=10

# ─── Email ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=<SECRET_b6b33eec>M_FROM=noreply@restaurantos.local
RESEND_API_KEY=
EMAIL_ENABLED=false

# ─── AI (cascade: gemini → openai → anthropic) ───
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_GEMINI=gemini-2.0-flash
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-sonnet-5
AI_MAX_TOKENS=2048
AI_ENABLED=false

# ─── AI recipe search (multimodal + cache + rate limit) ───
# The cascade order above (AI_PROVIDER=gemini) means: try Gemini first, then
# OpenAI, then Claude (Anthropic). If GEMINI_API_KEY is empty, the search
# automatically falls through to the next key that IS set — the "if one
# provider fails, the other catches up" behavior. Leave every key empty and
# recipe search degrades to catalog-only results (no LLM), with a clear note.
AI_MULTIMODAL_ENABLED=true
AI_RECIPE_CACHE_MAXSIZE=256
AI_RECIPE_CACHE_TTL_SECONDS=300
AI_RATE_CAPACITY=10
AI_RATE_PER_SECOND=2
AI_RECIPE_RATE_LIMIT_PER_MIN=5
AI_RECIPE_MAX_RESULTS=5
ZOMATO_MENU_BASE=https://www.zomato.com/api/v5
SWIGGY_MENU_BASE=https://api.swiggy.com/api

# ─── Payments ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=<SECRET_4728b9b9>Y_MODE=true
STRIPE_SECRET_KEY=<SECRET_08bd9145>ERCHANT_ID=
PHONEPE_SALT_KEY=
PAYTM_MERCHANT_ID=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=<SECRET_bd5fa5bf>NT_ID=
COD_ENABLED=true
CREDIT_SALE_ENABLED=false

# ─── Tax / GST (Whitebooks GSP) ───
WHITEBOOKS_ENABLED=false
WHITEBOOKS_GSP_APP_KEY=
WHITEBOOKS_GSP_CLIENT_ID=
WHITEBOOKS_GSP_CLIENT_SECRET=<SECRET_c89b7c3f>NAME=
WHITEBOOKS_GSP_PASSWORD=
WHITEBOOKS_GSP_GSTIN=
WHITEBOOKS_GSP_BASE_URL=https://gsp.whitebooks.com
EINVOICE_ENABLED=false
EWAY_BILL_ENABLED=false

# ─── Aggregators ───
ZOMATO_ENABLED=false
ZOMATO_API_KEY=
SWIGGY_ENABLED=false
SWIGGY_API_KEY=
MAGICPIN_ENABLED=false
DOTPE_ENABLED=false

# ─── Locale ───
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN

# ─── Demo seed ───
SEED_DEMO_DATA=true
DEMO_OWNER_EMAIL=owner@demo.com
DEMO_OWNER_PASSWORD=<SECRET_7d8615b9>

# ─── Platform super admin ───
# Consumed only by scripts/seed_platform_admin.py — never read at runtime.
# The platform service does NOT seed an admin at startup; you create the one
# account that can reach every tenant yourself. No defaults on purpose.
#
#   python scripts/seed_platform_admin.py --generate
#
# Min 12 chars with upper, lower, digit and symbol. --generate mints a random
# one and prints it exactly once, if you'd rather not store it here at all.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
